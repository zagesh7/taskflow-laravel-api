APP_NAME=TaskFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
DJANGO_OVERDUE_URL=http://127.0.0.1:8001
OVERDUE_SYNC_TOKEN=change-me-in-both-services
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Wasmer provides DB_NAME; the Laravel config uses it when DB_DATABASE is unset.
DB_DATABASE=taskflow
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
